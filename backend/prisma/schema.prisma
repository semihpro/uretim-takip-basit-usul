// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// WORKSTATION - İş İstasyonu
// ============================================
model Workstation {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  routes      ProductRoute[]
  scanEvents  ScanEvent[]

  @@map("workstations")
}

// ============================================
// PRODUCT - Ürün (BOM)
// ============================================
model Product {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  unit        String?  // adet, kg, mt, vs
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime? // Soft delete

  // Self-referencing for BOM hierarchy
  parentId    String?
  parent      Product?  @relation("ProductHierarchy", fields: [parentId], references: [id])
  children    Product[] @relation("ProductHierarchy")
  level       Int      @default(1) // 1 = root, 2 = child, etc.

  // Relations
  routes           ProductRoute[]
  productionOrders ProductionOrder[]

  @@map("products")
}

// ============================================
// PRODUCT ROUTE - Ürün Rotası (İş İstasyonu Sırası)
// ============================================
model ProductRoute {
  id           String       @id @default(cuid())
  productId    String
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  workstationId String
  workstation  Workstation @relation(fields: [workstationId], references: [id])
  stepOrder    Int
  isFinalStep  Boolean      @default(false)
  expectedDuration Int?    // dakika cinsinden
  notes        String?
  createdAt    DateTime     @default(now())

  @@unique([productId, workstationId, stepOrder])
  @@map("product_routes")
}

// ============================================
// USER - Kullanıcı
// ============================================
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String   // hashed
  badgeId      String?  @unique // Operatör kart ID
  fullName     String
  role         String   @default("operator") // admin, supervisor, operator
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  productionOrders ProductionOrder[]
  scanEvents       ScanEvent[]

  @@map("users")
}

// ============================================
// PRODUCTION ORDER - Üretim Emri
// ============================================
model ProductionOrder {
  id          String    @id @default(cuid())
  orderNo     String    @unique
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  status      String    @default("draft") // draft, in_progress, completed, cancelled
  dueDate     DateTime?
  notes       String?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  // Relations
  units      ProductionUnit[]

  @@map("production_orders")
}

// ============================================
// PRODUCTION UNIT - Üretim Birimi (Barkodlu Parça)
// ============================================
model ProductionUnit {
  id                  String      @id @default(cuid())
  orderId             String
  order               ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  barcode             String      @unique
  currentStep         Int         @default(0)
  status              String      @default("pending") // pending, in_progress, completed, rejected
  currentWorkstationId String?
  completedAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime    @default(now())

  // Relations
  scanEvents          ScanEvent[]

  @@map("production_units")
}

// ============================================
// SCAN EVENT - Tarama Kaydı
// ============================================
model ScanEvent {
  id              String          @id @default(cuid())
  unitId          String
  unit            ProductionUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  workstationId   String
  workstation     Workstation     @relation(fields: [workstationId], references: [id])
  scannedById     String?
  scannedBy       User?           @relation(fields: [scannedById], references: [id])
  result          String          // accepted, wrong_station, duplicate, rejected
  isRootScan      Boolean         @default(false)
  notes           String?
  deviceId        String?
  createdAt       DateTime        @default(now())

  @@map("scan_events")
}
